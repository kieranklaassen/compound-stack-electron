{
  "name": "compound-stack-electron",
  "version": "0.1.0",
  "private": true,
  "description": "The Electron starter that pairs with compound-stack-rails: a locked-down shell, a typed bridge, a React page, and the UX habits worth keeping.",
  "license": "MIT",
  "type": "module",
  "main": "shell/main.mjs",
  "scripts": {
    "dev": "node bin/dev.mjs",
    "page": "vite build --config page/vite.config.ts",
    "start": "npm run page && electron .",
    "types": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:page": "vitest run",
    "test:shell": "node --test --test-timeout=60000 \"test/shell/*.test.mjs\" \"test/template/*.test.mjs\"",
    "check": "npm run types && npm run test:page && npm run test:shell",
    "test:e2e": "npm run page && node --test --test-timeout=180000 --test-concurrency=1 \"test/e2e/*.test.mjs\"",
    "package": "npm run page && node bin/package.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "appId": "com.example.compound",
  "productName": "Compound"
}
